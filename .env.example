# Ustaw w Vercel: Project → Settings → Environment Variables (nie commituj realnych wartości)

# Required — OAuth2 client_credentials na sales-demo-pbx2 (/o/applications/)
client_id_sales_demo=
client_secret_sales_demo=

# Required — hasło do /admin.html (POST/PUT /api/products). Nie reużywaj hasła z oryginału.
ADMIN_PASSWORD=

# Optional — zostaw puste żeby użyć defaultów z sales-demo-pbx2
PBX_STORE_ID=
PBX_BASE_URL=
PBX_SITE_NAME=

# Auto — wstrzykiwane przez Vercel po Storage → Create Database → Blob (link do TEGO projektu)
BLOB_READ_WRITE_TOKEN=
